{
    "name": "statbox",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=26 <27"
    },
    "packageManager": "bun@1.4.4",
    "homepage": "https://github.com/Jubstaaa/statbox",
    "repository": {
        "type": "git",
        "url": "https://github.com/Jubstaaa/statbox.git"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next typegen && eslint --max-warnings 0",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "next typegen && tsc --noEmit",
        "audit": "bun audit --audit-level=high",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "knip": "knip",
        "jscpd": "jscpd src",
        "depcruise": "depcruise src next.config.ts",
        "smoke": "bun scripts/smoke.ts"
    },
    "knip": {
        "ignoreDependencies": [
            "sharp"
        ]
    },
    "dependencies": {
        "@libsql/client": "^0.18.0",
        "@tanstack/react-query": "^5.108.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "lucide-react": "^1.76.0",
        "lz-string": "^1.5.0",
        "next": "16.4.6",
        "p-memoize": "^9.0.0",
        "p-throttle": "^8.1.1",
        "p-timeout": "^8.1.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "server-only": "^0.0.1",
        "sharp": "^0.35.5",
        "simple-icons": "^16.38.0",
        "tailwind-merge": "^3.7.0",
        "twisted": "1.83.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@jubstaa/config": "^1.6.0",
        "@tailwindcss/postcss": "^4.3.5",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^6.3.0",
        "dependency-cruiser": "^18.8.0",
        "eslint": "^10.15.0",
        "eslint-config-next": "16.4.6",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "happy-dom": "^21.0.4",
        "jscpd": "^5.4.3",
        "knip": "^6.47.0",
        "postcss": "^8.5.33",
        "prettier": "^3.10.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.5",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "vitest": "^5.1.1"
    },
    "ignoreScripts": [
        "sharp",
        "unrs-resolver"
    ],
    "trustedDependencies": [
        "sharp",
        "unrs-resolver"
    ]
}
