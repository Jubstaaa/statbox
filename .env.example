# Riot API key from https://developer.riotgames.com (a development key expires
# every 24 hours). Server-side only.
RIOT_API_KEY=RGAPI-your-riot-api-key

# Optional. libsql URL of the server-side response cache; defaults to a SQLite
# file in the working directory.
# CACHE_DATABASE_URI=file:./statbox-cache.db

# Not read by the app: base URL `bun run smoke` tests (default
# http://127.0.0.1:3003, the port docker-compose.yml publishes).
# SMOKE_BASE_URL=http://127.0.0.1:3003
